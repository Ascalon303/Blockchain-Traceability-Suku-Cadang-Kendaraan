# Salin menjadi .env di SETIAP laptop (cp .env.example .env), lalu isi alamat laptop LAWAN.
# Format: IP:port. Cek IP dengan `ipconfig` (Windows) atau `ip a` (Linux/Mac).
#
# Di laptop 1 isi alamat laptop 2, contoh:
#   PEER_ADDR=192.168.1.11:9002
# Di laptop 2 isi alamat laptop 1, contoh:
#   PEER_ADDR=192.168.1.10:9001
PEER_ADDR=192.168.1.11:9002
